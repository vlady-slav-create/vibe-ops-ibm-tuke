{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "timestamp": {
      "type": "string", "maxLength": 40, "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "eventId": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "evidencePath": {"enum": ["/", "/login", "/api/health", "/api/schedule", "/api/courses", "/api/grades", "[other]"]},
    "redactedField": {
      "type": "string",
      "pattern": "^(request|response)\\.(body\\.(password|passwd|pwd|secret|token|access_token|refresh_token|id_token|api_key|apikey)|headers\\.(authorization|cookie|set-cookie|x-api-key))$",
      "not": {"pattern": "\\s"}
    },
    "ruleId": {"type": "string", "minLength": 1, "maxLength": 8, "not": {"pattern": "[^0-9]"}},
    "mode": {"enum": ["single", "orchestrator", "graph"]},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "risk", "confidence", "instances"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/ruleId"},
        "risk": {"type": "integer", "minimum": 0, "maximum": 3},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 4},
        "instances": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/()'\"-]{1,100}$"},
        "paths": {"type": "array", "uniqueItems": true, "maxItems": 7, "items": {"$ref": "#/$defs/evidencePath"}},
        "params": {"type": "array", "uniqueItems": true, "maxItems": 10, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$", "not": {"pattern": "[0-9]{4,}|^[A-Fa-f0-9]{12,}$"}}},
        "schemes": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"enum": ["http", "https"]}}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false, "required": ["findings"],
      "properties": {"findings": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/finding"}}}
    },
    "exposure": {
      "type": "object", "additionalProperties": false,
      "required": ["http_requests", "https_requests"],
      "properties": {
        "http_requests": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "https_requests": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "tls_client_rejected": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "tlsConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["scanned", "self_signed", "expired", "chain_trusted_all_stores", "protocols_accepted", "accepted_ciphers"],
      "properties": {
        "scanned": {"const": true},
        "self_signed": {"type": "boolean"},
        "expired": {"type": "boolean"},
        "chain_trusted_all_stores": {"type": "boolean"},
        "protocols_accepted": {"type": "array", "uniqueItems": true, "maxItems": 6,
          "items": {"enum": ["SSL 2.0", "SSL 3.0", "TLS 1.0", "TLS 1.1", "TLS 1.2", "TLS 1.3"]}},
        "accepted_ciphers": {"type": "array", "uniqueItems": true, "maxItems": 40,
          "items": {"type": "string", "pattern": "^(TLS|SSL)_[A-Z0-9_]{4,64}$"}}
      }
    },
    "zapInput": {
      "type": "object", "required": ["source", "event", "asset_id", "captured_at", "current"],
      "properties": {
        "source": {"const": "zap-passive"}, "event": {"const": "zap_scan"},
        "asset_id": {"const": "demo-portal"}, "captured_at": {"$ref": "#/$defs/timestamp"},
        "current": {"$ref": "#/$defs/snapshot"},
        "exposure": {"$ref": "#/$defs/exposure"},
        "tls_config": {"$ref": "#/$defs/tlsConfig"}
      }
    },
    "networkInput": {
      "type": "object", "required": ["source", "event", "captured_at"],
      "properties": {
        "source": {"const": "network-capture"},
        "event": {"enum": ["http_exchange", "tls_client_rejected"]},
        "captured_at": {"$ref": "#/$defs/timestamp"}
      },
      "if": {"properties": {"event": {"const": "http_exchange"}}},
      "then": {
        "required": ["scheme", "tls_terminated_by_proxy", "request", "response"],
        "properties": {
          "scheme": {"enum": ["http", "https"]}, "tls_terminated_by_proxy": {"type": "boolean"},
          "request": {
            "type": "object", "required": ["method", "path"],
            "properties": {
              "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
              "path": {"type": "string"}
            }
          },
          "response": {
            "type": "object", "required": ["status_code"],
            "properties": {"status_code": {"type": "integer", "minimum": 100, "maximum": 599}}
          },
          "redacted_fields": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "rawEvent": {"oneOf": [{"$ref": "#/$defs/zapInput"}, {"$ref": "#/$defs/networkInput"}]},
    "event": {
      "oneOf": [
        {
          "allOf": [{"$ref": "#/$defs/zapInput"}],
          "type": "object", "additionalProperties": false, "required": ["event_id"],
          "properties": {
            "source": {}, "event": {}, "asset_id": {}, "captured_at": {}, "current": {}, "exposure": {}, "tls_config": {},
            "event_id": {"$ref": "#/$defs/eventId"}
          }
        },
        {
          "allOf": [{"$ref": "#/$defs/networkInput"}],
          "type": "object", "additionalProperties": false,
          "properties": {
            "source": {}, "event": {"const": "http_exchange"}, "captured_at": {},
            "event_id": {"$ref": "#/$defs/eventId"}, "scheme": {}, "tls_terminated_by_proxy": {},
            "request": {
              "additionalProperties": false,
              "properties": {
                "method": {},
                "path": {"$ref": "#/$defs/evidencePath"}
              }
            },
            "response": {"additionalProperties": false, "properties": {"status_code": {}}},
            "redacted_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/redactedField"}}
          },
          "required": ["event_id", "redacted_fields"]
        },
        {
          "allOf": [{"$ref": "#/$defs/networkInput"}],
          "type": "object", "additionalProperties": false, "required": ["event_id"],
          "properties": {
            "source": {}, "event": {"const": "tls_client_rejected"}, "captured_at": {},
            "event_id": {"$ref": "#/$defs/eventId"}
          }
        }
      ]
    },
    "invocation": {
      "type": "object", "additionalProperties": false, "required": ["mode", "events"],
      "properties": {
        "mode": {"$ref": "#/$defs/mode"},
        "events": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "workflowInvocation": {
      "allOf": [{"$ref": "#/$defs/invocation"}],
      "properties": {"events": {"maxItems": 1}}
    },
    "text": {"type": "string", "minLength": 1, "pattern": "\\S", "not": {"pattern": "[\\u0000-\\u001f]"}},
    "workItem": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "group", "rule_ids", "title", "severity", "rationale", "owner_role", "observation", "hypothesis", "fix", "retest", "limitations"],
      "properties": {
        "event_id": {"$ref": "#/$defs/eventId"},
        "group": {"enum": ["cookie-hardening", "security-headers", "url-exposure", "authentication", "tls", "other"]},
        "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleId"}},
        "title": {"$ref": "#/$defs/text", "maxLength": 120},
        "severity": {"enum": ["INFORMATIONAL", "LOW", "MEDIUM", "HIGH"]},
        "rationale": {"$ref": "#/$defs/text", "maxLength": 300},
        "owner_role": {"$ref": "#/$defs/text", "maxLength": 80},
        "observation": {"$ref": "#/$defs/text", "maxLength": 450},
        "hypothesis": {"$ref": "#/$defs/text", "maxLength": 400},
        "fix": {"$ref": "#/$defs/text", "maxLength": 500},
        "retest": {"$ref": "#/$defs/text", "maxLength": 500},
        "limitations": {"$ref": "#/$defs/text", "maxLength": 500}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false, "required": ["summary", "work_items"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 600},
        "work_items": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/workItem"}}
      }
    },
    "analysisResult": {
      "type": "object", "additionalProperties": false, "required": ["mode", "report", "specialists"],
      "properties": {
        "mode": {"$ref": "#/$defs/mode"}, "report": {"$ref": "#/$defs/report"},
        "specialists": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "resultKeys": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "string", "pattern": "^results/(single|orchestrator|graph)/[0-9a-f]{64}\\.json$", "not": {"pattern": "\\s"}, "maxLength": 90}
    }
  }
}